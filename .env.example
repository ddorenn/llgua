# Copy to .env.local and fill in what you need. Nothing here is required to preview locally:
# with no auth variables set, `npm run dev` runs in a clearly labelled, NON-SECURE demo mode.

# --- Authentication: option A — Supabase Auth (recommended for deployment) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Authentication: option B — single private account (no external service) ---
# Generate both values with:  npm run auth:hash -- "your-long-password"
# LINGUA_AUTH_USERNAME=me
# LINGUA_AUTH_PASSWORD_HASH='scrypt$16384$8$1$...'
# LINGUA_SESSION_SECRET='random-32-byte-secret'

# Demo mode is off in production builds unless you explicitly allow it (not recommended):
# LINGUA_ALLOW_DEMO=true

# --- AI tutor (optional) ---
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium
