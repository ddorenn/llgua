        { "id": "v2", "type": "mcq", "level": "B1", "prompt": "I'm really looking forward ___ the holiday.", "options": ["for", "to", "at", "on"], "answer": 1, "tag": "prepositions" },
        { "id": "v3", "type": "mcq", "level": "B2", "prompt": "She made a ___ effort to finish on time.", "options": ["strong", "deliberate", "heavy", "tall"], "answer": 1, "tag": "collocations" },
        { "id": "v4", "type": "mcq", "level": "C1", "prompt": "His explanation was so ___ that nobody understood it.", "options": ["lucid", "convoluted", "concise", "vivid"], "answer": 1, "tag": "advanced-adjectives" },
