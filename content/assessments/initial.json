      "id": "reading",
      "title": "Reading",
      "skill": "reading",
      "passage": "Most people believe that multitasking makes them more productive. Research suggests the opposite: when we switch between tasks, our brain needs time to refocus, and small delays add up. People who focus on one task at a time often finish faster and make fewer mistakes.",
      "questions": [
        { "id": "r1", "type": "mcq", "level": "B1", "prompt": "What does the research suggest?", "options": ["Multitasking is more productive", "Switching tasks costs time", "The brain never needs to refocus", "Mistakes are unavoidable"], "answer": 1, "tag": "main-idea" },
        { "id": "r2", "type": "mcq", "level": "B2", "prompt": "“Small delays add up” means…", "options": ["delays disappear", "delays become significant together", "delays are pleasant", "delays help focus"], "answer": 1, "tag": "inference" }
