      "questions": [
        { "id": "g1", "type": "mcq", "level": "A1", "prompt": "She ___ a teacher.", "options": ["am", "is", "are", "be"], "answer": 1, "tag": "to-be" },
        { "id": "g2", "type": "mcq", "level": "A2", "prompt": "We ___ to the cinema last night.", "options": ["go", "goes", "went", "have gone"], "answer": 2, "tag": "past-simple" },
        { "id": "g3", "type": "mcq", "level": "B1", "prompt": "I ___ here since 2019.", "options": ["live", "lived", "have lived", "am living"], "answer": 2, "tag": "present-perfect" },
        { "id": "g4", "type": "mcq", "level": "B1", "prompt": "If it rains, we ___ at home.", "options": ["stay", "will stay", "would stay", "stayed"], "answer": 1, "tag": "conditionals" },
        { "id": "g5", "type": "mcq", "level": "B2", "prompt": "If I ___ about the problem, I would have helped.", "options": ["knew", "had known", "have known", "would know"], "answer": 1, "tag": "conditionals" },
        { "id": "g6", "type": "gap", "level": "A2", "prompt": "There isn't ___ milk in the fridge. (some / any)", "accepted": ["any"], "tag": "quantifiers" },
        { "id": "g7", "type": "mcq", "level": "C1", "prompt": "Not only ___ late, but he also forgot the tickets.", "options": ["he was", "was he", "he is", "did he"], "answer": 1, "tag": "inversion" },
        { "id": "g8", "type": "mcq", "level": "B2", "prompt": "The bridge ___ in 1890.", "options": ["built", "was built", "has built", "is building"], "answer": 1, "tag": "passive" }
