  "id": "general-english",
  "title": "Общий английский (A1–C2)",
  "unlockRule": "sequential",
  "modules": [
    {
      "id": "a1-foundations",
      "level": "A1",
      "title": "Основы",
      "skill": "grammar",
      "description": "Глагол to be, личные местоимения и простые вопросы.",
      "lessons": [
        {
          "id": "a1-to-be",
          "title": "Глагол to be",
          "skill": "grammar",
          "minutes": 15,
          "objectives": [
            "Правильно использовать am / is / are",
            "Строить отрицания и общие вопросы"
          ],
          "blocks": [
            {
              "type": "text",
              "title": "Объяснение",
              "body": "We use **to be** to talk about identity, age, origin, jobs and feelings. Its forms change with the subject: *I am*, *you/we/they are*, *he/she/it is*.\n\nВ русском языке глагол «быть» в настоящем времени обычно опускается («Я студент»), но в английском он обязателен: **I am a student.**"
            },
            {
              "type": "examples",
              "title": "Примеры",
              "items": [
                {
                  "en": "I am from Moscow.",
                  "ru": "Я из Москвы."
                },
                {
                  "en": "She isn't at home.",
                  "ru": "Её нет дома."
                },
                {
                  "en": "Are you ready?",
                  "ru": "Ты готов?"
                }
              ]
            },
            {
              "type": "tip",
              "body": "Сокращения (I'm, you're, isn't) — норма в устной речи и неформальном письме."
            },
            {
              "type": "quiz",
              "title": "Проверь себя",
              "questions": [
                {
                  "id": "q1",
                  "prompt": "They ___ my friends.",
                  "options": [
                    "is",
                    "am",
                    "are"
                  ],
                  "answer": 2,
                  "explanation": "Plural subject *they* takes *are*."
                },
                {
                  "id": "q2",
                  "prompt": "___ he a doctor?",
                  "options": [
                    "Is",
                    "Are",
                    "Am"
                  ],
                  "answer": 0,
                  "explanation": "Questions invert the verb: *Is he…?*"
                },
                {
                  "id": "q3",
                  "prompt": "I ___ not tired.",
                  "options": [
                    "is",
                    "am",
                    "are"
                  ],
                  "answer": 1,
                  "explanation": "*I* always takes *am*."
                }
              ]
            }
          ]
        },
        {
          "id": "a1-present-simple",
          "title": "Present Simple: распорядок дня",
          "skill": "grammar",
          "minutes": 15,
          "objectives": [
            "Рассказывать о своём распорядке",
            "Использовать окончание -s/-es с he/she/it"
          ],
          "blocks": [
            {
              "type": "text",
              "title": "Объяснение",
              "body": "Use the **Present Simple** for habits, routines and facts. Add **-s/-es** for *he, she, it*: *She works*, *He watches*.\n\nNegatives and questions use **do/does**: *I don't drink coffee. Does she live here?*"
            },
            {
              "type": "examples",
              "title": "Примеры",
              "items": [
                {
                  "en": "I get up at seven.",
                  "ru": "Я встаю в семь."
                },
                {
                  "en": "He doesn't work on Sundays.",
                  "ru": "Он не работает по воскресеньям."
                }
              ]
            },
            {
              "type": "quiz",
              "title": "Проверь себя",
              "questions": [
                {
                  "id": "q1",
                  "prompt": "My sister ___ in a bank.",
                  "options": [
                    "work",
                    "works",
                    "working"
                  ],
                  "answer": 1,
                  "explanation": "Third person singular adds -s."
                },
                {
                  "id": "q2",
                  "prompt": "___ you like tea?",
                  "options": [
                    "Does",
                    "Are",
                    "Do"
                  ],
                  "answer": 2,
                  "explanation": "*you* takes *do* in questions."
                }
              ]
            }
          ]
        },
        {
          "id": "a1-everyday-words",
          "title": "Слова на каждый день: дом и семья",
          "skill": "vocabulary",
          "minutes": 10,
          "objectives": [
            "Называть членов семьи и комнаты"
          ],
          "blocks": [
            {
              "type": "examples",
              "title": "Ключевые слова",
              "items": [
                {
                  "en": "parents",
                  "ru": "родители"
                },
                {
                  "en": "kitchen",
                  "ru": "кухня"
                },
                {
                  "en": "neighbour",
                  "ru": "сосед"
                }
              ]
            },
            {
              "type": "quiz",
              "title": "Проверь себя",
              "questions": [
                {
                  "id": "q1",
                  "prompt": "The room where you cook is the ___.",
                  "options": [
                    "bedroom",
                    "kitchen",
                    "hall"
                  ],
                  "answer": 1
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "a2-past-and-plans",
      "level": "A2",
      "title": "Прошлое и планы",
      "skill": "grammar",
      "description": "Past Simple, конструкция going to и рассказ об опыте.",
      "lessons": [
        {
          "id": "a2-past-simple",
          "title": "Past Simple: правильные и неправильные глаголы",
          "skill": "grammar",
          "minutes": 15,
          "objectives": [
            "Говорить о завершённых действиях в прошлом",
            "Использовать частые неправильные глаголы"
          ],
          "blocks": [
            {
              "type": "text",
              "title": "Объяснение",
              "body": "The **Past Simple** describes finished actions at a specific time. Regular verbs add **-ed** (*worked*); irregular verbs have their own forms (*go → went*, *see → saw*).\n\nNegatives and questions use **did** + base form: *I didn't go. Did you see it?*"
            },
            {
              "type": "quiz",
              "title": "Проверь себя",
              "questions": [
                {
                  "id": "q1",
                  "prompt": "We ___ to Spain last summer.",
                  "options": [
                    "go",
                    "went",
                    "gone"
                  ],
                  "answer": 1
                },
                {
                  "id": "q2",
                  "prompt": "Did she ___ the email?",
                  "options": [
                    "send",
                    "sent",
                    "sends"
                  ],
                  "answer": 0,
                  "explanation": "After *did*, use the base form."
                }
              ]
            }
          ]
        },
        {
          "id": "a2-going-to",
          "title": "Планы с going to",
          "skill": "grammar",
          "minutes": 15,
          "objectives": [
            "Рассказывать о намерениях и планах"
          ],
          "blocks": [
            {
              "type": "text",
              "title": "Объяснение",
              "body": "Use **be going to + verb** for plans and intentions decided before the moment of speaking: *I'm going to study tonight.*"
            },
            {
              "type": "quiz",
              "title": "Проверь себя",
              "questions": [
                {
                  "id": "q1",
                  "prompt": "They ___ going to move next year.",
                  "options": [
                    "is",
                    "are",
                    "be"
                  ],
                  "answer": 1
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "b1-experience",
      "level": "B1",
      "title": "Опыт и мнение",
      "skill": "grammar",
      "description": "Present Perfect и Past Simple, выражение мнения, связки.",
      "lessons": [
        {
          "id": "b1-present-perfect",
          "title": "Present Perfect или Past Simple",
          "skill": "grammar",
          "minutes": 15,
          "objectives": [
            "Выбирать между Present Perfect и Past Simple",
            "Использовать ever / never / already / yet"
          ],
          "blocks": [
            {
              "type": "text",
              "title": "Объяснение",
              "body": "**Present Perfect** (*have/has + past participle*) connects the past with now: life experience, recent results, unfinished time periods.\n\n**Past Simple** is for finished time: *yesterday, in 2019, last week*.\n\nТипичная ошибка русскоязычных студентов — *I have seen him yesterday*. Если время указано и закончилось, используйте Past Simple: **I saw him yesterday.**"
            },
            {
              "type": "examples",
              "title": "Примеры",
              "items": [
                {
                  "en": "I've never been to Japan.",
                  "ru": "Я никогда не был в Японии."
                },
                {
                  "en": "She has already finished.",
                  "ru": "Она уже закончила."
                },
                {
                  "en": "We met in 2020.",
                  "ru": "Мы познакомились в 2020 году."
                }
              ]
            },
            {
              "type": "quiz",
              "title": "Проверь себя",
              "questions": [
                {
                  "id": "q1",
                  "prompt": "I ___ this film three times.",
                  "options": [
                    "saw",
                    "have seen",
                    "see"
                  ],
                  "answer": 1,
                  "explanation": "Life experience, no finished time → Present Perfect."
                },
                {
                  "id": "q2",
                  "prompt": "He ___ the report yesterday.",
                  "options": [
                    "has sent",
                    "sent",
                    "sends"
                  ],
                  "answer": 1,
                  "explanation": "*yesterday* is a finished time → Past Simple."
                },
                {
                  "id": "q3",
                  "prompt": "Have you finished ___?",
                  "options": [
                    "already",
                    "yet",
                    "ever"
                  ],
                  "answer": 1,
                  "explanation": "*yet* goes at the end of questions and negatives."
                }
              ]
            }
          ]
        },
        {
          "id": "b1-opinions",
          "title": "Как выражать и аргументировать мнение",
          "skill": "speaking",
          "minutes": 15,
          "objectives": [
            "Использовать фразы для мнения",
            "Подкреплять мнение причиной и примером"
          ],
          "blocks": [
            {
              "type": "examples",
              "title": "Полезные фразы",
              "items": [
                {
                  "en": "In my view, …",
                  "ru": "На мой взгляд, …"
                },
                {
                  "en": "The main reason is that …",
                  "ru": "Главная причина в том, что …"
                },
                {
                  "en": "For instance, …",
                  "ru": "Например, …"
                }
              ]
            },
            {
              "type": "tip",
              "body": "Сильный ответ = мнение + причина + пример. Потренируй эту схему на странице «Разговорная практика»."
            }
          ]
        },
        {
          "id": "b1-linking",
          "title": "Слова-связки в письме",
          "skill": "writing",
          "minutes": 15,
          "objectives": [
            "Связывать мысли с помощью however, although, therefore"
          ],
          "blocks": []
        }
      ]
